generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          Role      @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
  accounts      Account[]
  sessions      Session[]
}

model Order {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PENDING)
  total         Decimal     @db.Decimal(10, 2)
  paymentId     String?
  paymentMethod String
  address       Json
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  name      String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  image     String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model Lead {
  id        String   @id @default(cuid())
  nombre    String
  apellido  String?
  dni       String?
  telefono  String
  email     String?
  provincia String?
  mensaje   String?
  createdAt DateTime @default(now())

  pedidos ConfiguracionPedido[]

  @@map("leads")
}

model ConfiguracionPedido {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId          String?
  lead            Lead?   @relation(fields: [leadId], references: [id])
  clienteNombre   String
  clienteEmail    String?
  clienteWhatsapp String?

  // Especificación del producto — capturada de punta a punta por el
  // configurador visual (/configurador), un único flujo con fotos.
  modelo String? // "10ft" | "20ft" | "40ft"

  finalidad String? // "inversor" | "agro" | "vivienda" | "turismo" | "empresa" | "sector-publico"
  provincia String?
  localidad String?

  habitaciones  Int?
  incluyeCocina Boolean @default(true)
  tipoCocina    String? // "electrico" | "gas"
  incluyeBano   Boolean @default(true)
  tipoAgua      String? // "calefon-electrico" | "termotanque-gas"
  lavarropas    String? // "sin" | "bano" | "cocina" | "externo"

  // Selecciones de materiales con foto — Record<selectorKey, optionId|null>,
  // ver MATERIAL_CATEGORY_GROUPS en src/components/configurador/StepMateriales.tsx
  materiales Json?
  upgrades   String[] @default([])

  tipoCliente    String? // "particular" | "empresa"
  razonSocial    String?
  nombreContacto String?

  precioEstimado Float? // snapshot de calcularPrecio() al momento del envío

  // ─── Gestión del pedido (post-venta) ──────────────────────
  numeroConsulta      String? // formato MOV-CONSULTA-{AÑO}-{NRO 3 dígitos}, generado al enviar el configurador
  numeroPedido        String? // formato MOV-{AÑO}-{NRO 3 dígitos}, generado al confirmar
  estadoPedido        String    @default("consulta") // "consulta" | "presupuestado" | "confirmado" | "en_produccion" | "en_transito" | "en_aduana" | "entregado"
  precioFinal         Float?
  anticipo            Float?
  saldoPendiente      Float?
  numeroFabrica       String?
  numeroContenedor    String?
  numeroBL            String?
  fechaConfirmacion   DateTime?
  fechaProduccion     DateTime?
  fechaDespacho       DateTime?
  fechaArriboEstimado DateTime?
  fechaEntrega        DateTime?
  notasInternas       String?
  notasCliente        String?

  // ─── Costos internos (nunca visibles para el cliente) ─────
  costoProveedor   Float?
  costoFlete       Float?
  costoAduana      Float?
  costoOtros       Float?
  costoTotal       Float?
  margenUSD        Float?
  margenPorcentaje Float?

  @@map("configuraciones_pedido")
}
